# Server-only. Required for encrypted hosted secrets; never expose this value to clients.
# New Supabase projects use SUPABASE_SECRET_KEY. Legacy service-role names are also supported.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# =============================================================================
# 0-2.ca Short URL Integration (Required for compact hosted pointers)
# =============================================================================
SHORT_URL_BASE_URL=https://0-2.ca
# Ghostpost sends the stable application identity "ghostpost" as the owner fingerprint.
GHOSTPOST_PUBLIC_URL=https://ghostpost-six.vercel.app

# =============================================================================
# OAuth Provider Configuration (Required for social login)
# =============================================================================
# Configure OAuth providers in your Supabase project dashboard:
# 1. Go to Authentication > Providers in your Supabase dashboard
# 2. Enable the providers you want to use (Google, GitHub, Discord, Twitter)
# 3. Add the OAuth credentials from each provider
# 4. Set the Site URL to your production domain (not localhost!)
# 5. Add redirect URLs for both development and production
#
# For each provider, you'll need to create an OAuth app:
# - Google: https://console.cloud.google.com/apis/credentials
# - GitHub: https://github.com/settings/developers
# - Discord: https://discord.com/developers/applications
# - Twitter/X: https://developer.twitter.com/en/portal/dashboard
#
# No additional environment variables needed here - Supabase handles OAuth!

# =============================================================================
# OpenAI Configuration (Required for AI content generation)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# This is required for the /compose page AI features to work
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Future: Social Media Platform API Credentials (Optional)
# =============================================================================
# These are NOT currently required. The app uses copy/paste workflow.
# Add these later when implementing direct platform API integrations.

# Twitter/X API v2 - https://developer.twitter.com/
# TWITTER_API_KEY=your-twitter-api-key
# TWITTER_API_SECRET=your-twitter-api-secret
# TWITTER_ACCESS_TOKEN=your-access-token
# TWITTER_ACCESS_SECRET=your-access-secret

# LinkedIn API - https://www.linkedin.com/developers/
# LINKEDIN_CLIENT_ID=your-client-id
# LINKEDIN_CLIENT_SECRET=your-client-secret
# LINKEDIN_ACCESS_TOKEN=your-access-token

# LinkedIn API - https://www.linkedin.com/developers/
# LINKEDIN_CLIENT_ID=your-client-id
# LINKEDIN_CLIENT_SECRET=your-client-secret
# LINKEDIN_ACCESS_TOKEN=your-access-token

# TikTok API - https://developers.tiktok.com/
# TIKTOK_CLIENT_KEY=your-client-key
# TIKTOK_CLIENT_SECRET=your-client-secret
# TIKTOK_ACCESS_TOKEN=your-access-token

# =============================================================================
# Analytics Configuration (Optional - for tracking decode events)
# =============================================================================
# Redis for analytics storage
# Format: redis://[username]:[password]@[host]:[port]
# Example: redis://default:your-password@your-redis-host.com:6379
REDIS_URL=redis://default:your-password@your-redis-host.com:6379

# =============================================================================
# Encryption Configuration (Required for secret message encryption)
# =============================================================================
# Master secret key for encrypting user secrets at rest
# CRITICAL: Generate a strong random key for production!
# You can generate one with: openssl rand -base64 32
# WARNING: Changing this key will make existing encrypted secrets unreadable
ENCRYPTION_MASTER_SECRET=your-strong-random-secret-key-change-this-in-production
