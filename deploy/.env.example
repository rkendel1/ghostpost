# Ghostpost Environment Configuration
# Copy this file to .env.local and fill in your values

# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Optional) Service role key for admin operations
# Only use this on backend/server - NEVER expose in frontend
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API Configuration
PUBLIC_API_URL=https://ghostpost.app
PUBLIC_API_TIMEOUT=30000

# Analytics Configuration (optional)
PUBLIC_ANALYTICS_ID=your-analytics-id
PUBLIC_TRACKING_ENABLED=true

# Feature Flags (optional)
PUBLIC_ENABLE_SECURE_NOTES=true
PUBLIC_ENABLE_CONVERSATIONAL=true
PUBLIC_ENABLE_ADAPTIVE_REVEALS=true
PUBLIC_ENABLE_STORY_FRAGMENTS=true

# Environment
NODE_ENV=production
