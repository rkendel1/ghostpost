{
	"name": "hidenly",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"dev:wasm": "npm run build:wasm && vite dev",
		"build": "vite build",
		"build:wasm": "wasm-pack build ./wasm --target web --release",
		"watch:wasm": "cd wasm && cargo watch -i .gitignore -i \"pkg/*\" -i \"target/*\" -s \"wasm-pack build --target web --dev\"",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.2.7",
		"@neoconfetti/svelte": "^2.2.2",
		"@poppanator/sveltekit-svg": "^6.0.1",
		"@skeletonlabs/skeleton": "^1.12.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.2.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@typescript-eslint/eslint-plugin": "^8.49.0",
		"@typescript-eslint/parser": "^8.49.0",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"postcss": "^8.5.6",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.45.8",
		"svelte-check": "^4.3.4",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^3.4.18",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.2.7",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.5.0",
		"vite-plugin-wasm-pack": "^0.1.12",
		"wasm": "./wasm/pkg"
	},
	"type": "module",
	"dependencies": {
		"dotenv": "^17.2.3"
	}
}
